<mxfile host="app.diagrams.net"><diagram id="d" name="Page-1"><mxGraphModel dx="1200" dy="470" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Where the startup time goes&lt;/b&gt; &lt;span style='font-weight:normal'&gt;(illustrative, not to scale)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1160" height="30" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Traditional VM&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#232F3E;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="180" height="40" as="geometry"/></mxCell><mxCell id="v3" value="VM + many virtual devices" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#DD3522;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="180" height="50" as="geometry"/></mxCell><mxCell id="v4" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="362" y="46" width="26" height="26" as="geometry"/></mxCell><mxCell id="v5" value="BIOS / UEFI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#DD3522;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="130" height="50" as="geometry"/></mxCell><mxCell id="v6" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="492" y="46" width="26" height="26" as="geometry"/></mxCell><mxCell id="v7" value="Bootloader" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#DD3522;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="60" width="120" height="50" as="geometry"/></mxCell><mxCell id="v8" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="612" y="46" width="26" height="26" as="geometry"/></mxCell><mxCell id="v9" value="Kernel + many drivers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="60" width="200" height="50" as="geometry"/></mxCell><mxCell id="v10" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="812" y="46" width="26" height="26" as="geometry"/></mxCell><mxCell id="v11" value="init (systemd) + services" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="60" width="230" height="50" as="geometry"/></mxCell><mxCell id="v12" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1042" y="46" width="26" height="26" as="geometry"/></mxCell><mxCell id="v13" value="App" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="60" width="90" height="50" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Firecracker microVM&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#232F3E;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="176" width="180" height="40" as="geometry"/></mxCell><mxCell id="v15" value="VMM + few devices" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="170" width="110" height="50" as="geometry"/></mxCell><mxCell id="v16" value="Small kernel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="120" height="50" as="geometry"/></mxCell><mxCell id="v17" value="Minimal init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="90" height="50" as="geometry"/></mxCell><mxCell id="v18" value="App" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="170" width="90" height="50" as="geometry"/></mxCell><mxCell id="v19" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="292" y="156" width="26" height="26" as="geometry"/></mxCell><mxCell id="v20" value="skipped: firmware and bootloader" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#8A8A8A;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="260" height="50" as="geometry"/></mxCell><mxCell id="v21" value="" style="shape=partialRectangle;html=1;top=0;right=1;left=1;bottom=1;fillColor=none;strokeColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="200" y="226" width="110" height="10" as="geometry"/></mxCell><mxCell id="v22" value="VMM ready for API calls:&lt;br&gt;~12 ms typical" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="150" y="238" width="210" height="40" as="geometry"/></mxCell><mxCell id="v23" value="" style="shape=partialRectangle;html=1;top=0;right=1;left=1;bottom=1;fillColor=none;strokeColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="310" y="226" width="210" height="10" as="geometry"/></mxCell><mxCell id="v24" value="InstanceStart → /sbin/init:&lt;br&gt;&lt;b&gt;≤ 125 ms&lt;/b&gt;*" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="305" y="238" width="220" height="40" as="geometry"/></mxCell><mxCell id="v25" value="App: depends on&lt;br&gt;your application" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="535" y="238" width="160" height="40" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;Minimal virtual hardware&lt;/b&gt;&lt;br&gt;Fewer devices to create, emulate and initialize; fewer drivers in the guest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;rounded=1;arcSize=8;spacingLeft=46;spacingTop=10;spacingRight=8;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="276" height="110" as="geometry"/></mxCell><mxCell id="v27" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="32" y="312" width="26" height="26" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;Direct kernel boot&lt;/b&gt;&lt;br&gt;No BIOS/UEFI and no bootloader: the kernel is loaded straight into guest memory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;rounded=1;arcSize=8;spacingLeft=46;spacingTop=10;spacingRight=8;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="312" y="300" width="276" height="110" as="geometry"/></mxCell><mxCell id="v29" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="324" y="312" width="26" height="26" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b&gt;Minimal guest OS&lt;/b&gt;&lt;br&gt;A tuned kernel, a small rootfs and a minimal init instead of systemd and services" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;rounded=1;arcSize=8;spacingLeft=46;spacingTop=10;spacingRight=8;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="604" y="300" width="276" height="110" as="geometry"/></mxCell><mxCell id="v31" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="616" y="312" width="26" height="26" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Lightweight VMM&lt;/b&gt;&lt;br&gt;A small machine model; KVM does the heavy lifting, and memory overhead stays ≤ 5 MiB*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;rounded=1;arcSize=8;spacingLeft=46;spacingTop=10;spacingRight=8;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="896" y="300" width="276" height="110" as="geometry"/></mxCell><mxCell id="v33" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="908" y="312" width="26" height="26" as="geometry"/></mxCell><mxCell id="v34" value="* Firecracker specification: tested on m5d.metal and m6g.metal hosts, 1 vCPU and 128 MiB, minimal kernel and rootfs, serial console disabled. The 5 MiB excludes the guest's memory." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F6B7A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1160" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>