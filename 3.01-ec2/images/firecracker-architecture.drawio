<mxfile host="app.diagrams.net"><diagram id="d" name="Page-1"><mxGraphModel dx="1160" dy="700" grid="1" gridSize="10" page="1" pageWidth="1160" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#879196;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1120" height="660" as="geometry"/></mxCell><mxCell id="v2" value="Linux host (for example, a bare-metal server)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontColor=#232F3E;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="24" width="600" height="28" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;You or the orchestrator&lt;/b&gt;&lt;br&gt;(a script, the lab, Lambda's control plane)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;TAP device&lt;/b&gt;&lt;br&gt;(host networking)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="220" height="60" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Files on the host&lt;/b&gt;&lt;br&gt;rootfs image (virtio-block)&lt;br&gt;kernel image (loaded at boot)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="220" height="76" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD3522;fontColor=#232F3E;fontSize=13;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="820" height="480" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Jailer sandbox&lt;/b&gt;: chroot · cgroups · namespaces · unprivileged user" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#DD3522;align=left;" vertex="1" parent="1"><mxGeometry x="310" y="74" width="800" height="26" as="geometry"/></mxCell><mxCell id="v8" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="104" width="780" height="430" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Firecracker process&lt;/b&gt;: one microVM per process · &lt;b&gt;seccomp&lt;/b&gt; filters on every thread" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#ED7100;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="108" width="760" height="26" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;API thread&lt;/b&gt;&lt;br&gt;HTTP API on a Unix socket: configure, start, pause and resume, snapshots. Never on the guest's fast path." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="145" width="250" height="90" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;VMM thread&lt;/b&gt;&lt;br&gt;device models: virtio-net · virtio-block · vsock · serial console · MMDS · I/O rate limiters" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="250" height="110" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;vCPU threads&lt;/b&gt;&lt;br&gt;one per guest vCPU; each runs the KVM_RUN loop" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="425" width="250" height="80" as="geometry"/></mxCell><mxCell id="v13" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="145" width="460" height="360" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Guest (the microVM)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#248814;align=left;" vertex="1" parent="1"><mxGeometry x="630" y="149" width="400" height="24" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Guest Linux kernel&lt;/b&gt;&lt;br&gt;sees vCPUs, memory and a few VirtIO devices" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="420" height="70" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Root filesystem&lt;/b&gt; (a file on the host, attached as virtio-block)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="385" width="420" height="60" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;init → your application&lt;/b&gt; (for example, an HTTP server)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="185" width="420" height="70" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;KVM&lt;/b&gt; (in the host kernel): runs guest code directly on the CPU (Intel VT-x / AMD-V), traps privileged operations (VM exits)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="590" width="820" height="70" as="geometry"/></mxCell><mxCell id="e19" value="API calls" style="html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1" source="v3" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="virtio-net" style="html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#147EBA;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="v4" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="virtio-block" style="html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#147EBA;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="v5" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="VirtIO devices" style="html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#147EBA;strokeWidth=2;exitX=1;exitY=0.45;entryX=0;entryY=0.5;" edge="1" parent="1" source="v11" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="KVM_RUN" style="html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#8C4FFF;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.17;entryY=0;" edge="1" parent="1" source="v12" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>