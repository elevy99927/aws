<mxfile host="app.diagrams.net"><diagram id="d" name="Page-1"><mxGraphModel dx="1100" dy="520" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBF5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1060" height="120" as="geometry"/></mxCell><mxCell id="v2" value="Host user space: the Firecracker process" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#ED7100;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="500" height="24" as="geometry"/></mxCell><mxCell id="v3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF7FF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="1060" height="150" as="geometry"/></mxCell><mxCell id="v4" value="Host kernel: KVM" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#8C4FFF;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="162" width="400" height="24" as="geometry"/></mxCell><mxCell id="v5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FBF3;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1060" height="100" as="geometry"/></mxCell><mxCell id="v6" value="Guest mode on the CPU (Intel VT-x / AMD-V)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#248814;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="332" width="400" height="24" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;vCPU thread&lt;/b&gt; calls &lt;b&gt;KVM_RUN&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="280" height="60" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Device model&lt;/b&gt; handles the I/O (for example a VirtIO MMIO access)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="55" width="400" height="70" as="geometry"/></mxCell><mxCell id="v9" value="KVM &lt;b&gt;enters guest mode&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="280" height="60" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;VM exit&lt;/b&gt;: the guest needs something privileged (device I/O, some instructions, an interrupt…)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="400" height="70" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Guest kernel and app run directly on the CPU&lt;/b&gt;, at near-native speed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="980" height="50" as="geometry"/></mxCell><mxCell id="e12" value="" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="run the guest" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.143;entryY=0;" edge="1" parent="1" source="v9" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="many exits are handled in KVM: resume the guest" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;fontColor=#8C4FFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v10" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="privileged operation" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#DD3522;strokeWidth=2;fontColor=#DD3522;exitX=0.8;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="v11" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="needs a device model" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="v10" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="KVM_RUN again" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v8" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Memory isolation&lt;/b&gt;: the CPU translates the guest's &quot;physical&quot; addresses to real host addresses (Intel EPT / AMD NPT). A guest can only reach the memory it was given." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1060" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>