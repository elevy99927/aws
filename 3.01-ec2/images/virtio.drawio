<mxfile host="app.diagrams.net"><diagram id="d" name="Page-1"><mxGraphModel dx="1100" dy="430" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="430" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Emulating a real network card (e1000)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="500" height="34" as="geometry"/></mxCell><mxCell id="v2" value="VirtIO (virtio-net)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="10" width="500" height="34" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Guest&lt;/b&gt;: the e1000 driver programs the card's registers, one access at a time" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="460" height="70" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;VMM&lt;/b&gt; emulates the real card's behavior, register by register" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="460" height="70" as="geometry"/></mxCell><mxCell id="v5" value="" style="text;" vertex="1" parent="1"><mxGeometry x="90" y="132" width="1" height="1" as="geometry"/></mxCell><mxCell id="v6" value="" style="text;" vertex="1" parent="1"><mxGeometry x="90" y="258" width="1" height="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#DD3522;strokeWidth=2;fontColor=#DD3522;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v8" value="" style="text;" vertex="1" parent="1"><mxGeometry