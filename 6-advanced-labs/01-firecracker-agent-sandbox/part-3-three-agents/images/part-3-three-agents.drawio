<mxCell id="you" value="&lt;b&gt;You&lt;/b&gt; (Part 4: a Lambda)&lt;br&gt;./run-job.sh &amp;lt;git-url&amp;gt; &amp;lt;ref&amp;gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;fontSize=13;fillColor=#232F3E;shape=mxgraph.aws4.client;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="80" height="80" as="geometry"/></mxCell>
<mxCell id="host" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="30" width="1030" height="650" as="geometry"/></mxCell>
<mxCell id="hostt" value="&lt;b&gt;EC2 host fc-agents-host&lt;/b&gt; (Part 2) · ~/fc · one job at a time (flock) · the host never runs anything from the repository" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="205" y="34" width="1000" height="28" as="geometry"/></mxCell>
<mxCell id="rj" value="&lt;b&gt;run-job.sh&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; cp --sparse base → jobs/&amp;lt;id&amp;gt;/rootfs.ext4 · start Firecracker · wait for SSH&lt;br&gt;&lt;b&gt;2&lt;/b&gt; ssh: git clone into /workspace · docker compose up · compose ps → exit codes&lt;br&gt;&lt;b&gt;3&lt;/b&gt; scp /results/*.json out · summary.json (jq) · kill the VM · rm the disk copy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="75" width="520" height="100" as="geometry"/></mxCell>
<mxCell id="base" value="&lt;b&gt;ubuntu-agents-base.ext4&lt;/b&gt; · the base image, version 2 (bake-agents.sh)&lt;br&gt;Part 2's image + git + the three images + the Trivy DB + the Semgrep rules&lt;br&gt;&lt;i&gt;never booted by a job: every job gets a sparse copy, deleted at the end&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="195" width="520" height="80" as="geometry"/></mxCell>
<mxCell id="jobs" value="&lt;b&gt;jobs/&amp;lt;id&amp;gt;/&lt;/b&gt; what stays on the host&lt;br&gt;results/deps.json · code.json · secrets.json&lt;br&gt;&lt;b&gt;summary.json&lt;/b&gt;: one status per agent (ok · findings · failed) and a verdict&lt;br&gt;exit-codes.txt · console.log · (rootfs.ext4 and fc.sock: deleted)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#879196;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="295" width="520" height="95" as="geometry"/></mxCell>
<mxCell id="tap" value="&lt;b&gt;tap0&lt;/b&gt; 172.16.0.1/30 · NAT (host-net.sh) · no instance metadata" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="410" width="520" height="45" as="geometry"/></mxCell>
<mxCell id="vm" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="75" width="440" height="580" as="geometry"/></mxCell>
<mxCell id="vmt" value="&lt;b&gt;microVM for this job&lt;/b&gt; · Firecracker, jobs/&amp;lt;id&amp;gt;/vm.json&lt;br&gt;2 vCPUs · 2 GiB · 172.16.0.2 · destroyed at the end" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="775" y="78" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="ws" value="&lt;b&gt;/workspace&lt;/b&gt; · git clone + checkout &amp;lt;ref&amp;gt;&lt;br&gt;&lt;i&gt;the job's only network call&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="130" width="400" height="55" as="geometry"/></mxCell>
<mxCell id="cmp" value="&lt;b&gt;/opt/agents/compose.yaml&lt;/b&gt; · three one-shot services · network_mode: none · pull_policy: never&lt;br&gt;&lt;b&gt;the contract&lt;/b&gt;: /workspace:ro and GIT_URL, REF in → /results/&amp;lt;agent&amp;gt;.json and an exit code out" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="200" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;deps&lt;/b&gt;&lt;br&gt;Trivy 0.76.2&lt;br&gt;vuln + misconfig&lt;br&gt;offline, baked DB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="290" width="125" height="90" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;code&lt;/b&gt;&lt;br&gt;Semgrep 1.185.0&lt;br&gt;p/supply-chain · p/security-audit · course rules" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="917" y="290" width="125" height="90" as="geometry"/></mxCell>
<mxCell id="a3" value="&lt;b&gt;secrets&lt;/b&gt;&lt;br&gt;Gitleaks 8.30.1&lt;br&gt;the tree and the git history" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1055" y="290" width="125" height="90" as="geometry"/></mxCell>
<mxCell id="res" value="&lt;b&gt;/results&lt;/b&gt; · deps.json · code.json · secrets.json&lt;br&gt;exit code 0 = ok · 1 = findings · other = failed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="400" height="55" as="geometry"/></mxCell>
<mxCell id="dk" value="Docker Engine + Compose · Ubuntu 24.04 · guest kernel 6.18.54 (Part 2)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="lim" value="&lt;b&gt;What this does, and what it doesn't&lt;/b&gt;: the microVM shrinks the blast radius; it doesn't prove the code is safe. The scanners catch known patterns. A clean summary means nothing known was found." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="525" width="400" height="75" as="geometry"/></mxCell>
<mxCell id="chk" value="&lt;b&gt;The check&lt;/b&gt; (check-jobs.sh): two jobs, two repositories. Job 1 finds the planted problems, job 2 is clean and started from a fresh guest (no /workspace, no /results), and afterwards: no Firecracker process, no disk copies." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontColor=#232F3E;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="210" y="480" width="520" height="70" as="geometry"/></mxCell>
<mxCell id="kvm" value="&lt;b&gt;KVM&lt;/b&gt; in the host kernel · &lt;b&gt;/dev/kvm&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="620" width="990" height="45" as="geometry"/></mxCell>
