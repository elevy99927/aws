<mxfile host="app.diagrams.net"><diagram id="ac" name="Agent contract"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="hd" value="&lt;b&gt;An agent contract&lt;/b&gt;: a formal definition of how agents talk to each other, divide the responsibility and pass results along. Every agent knows what it gets, what it must return, what it may do, and what happens when it fails." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="grp" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="800" height="540" as="geometry"/></mxCell>
<mxCell id="grpt" value="&lt;b&gt;The six parts&lt;/b&gt;, and how this lab fills them for the three scanner agents" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="35" y="69" width="760" height="26" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;1 · Input contract&lt;/b&gt;&lt;br&gt;&lt;i&gt;what the agent receives, and in what format&lt;/i&gt;&lt;br&gt;&lt;br&gt;here: the repository at &lt;b&gt;/workspace&lt;/b&gt;, read-only · &lt;b&gt;GIT_URL&lt;/b&gt; and &lt;b&gt;REF&lt;/b&gt; as environment variables" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="35" y="105" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;2 · Output contract&lt;/b&gt;&lt;br&gt;&lt;i&gt;what it must return, for example JSON that follows a schema&lt;/i&gt;&lt;br&gt;&lt;br&gt;here: &lt;b&gt;/results/&amp;lt;agent&amp;gt;.json&lt;/b&gt; in the scanner's native format, and an &lt;b&gt;exit code&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="105" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;3 · Responsibilities&lt;/b&gt;&lt;br&gt;&lt;i&gt;what the agent is accountable for&lt;/i&gt;&lt;br&gt;&lt;br&gt;here: one kind of risk each. &lt;b&gt;deps&lt;/b&gt;: vulnerable dependencies and bad Dockerfiles · &lt;b&gt;code&lt;/b&gt;: dangerous code patterns · &lt;b&gt;secrets&lt;/b&gt;: keys and tokens, tree and history" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="35" y="230" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;4 · Permissions&lt;/b&gt;&lt;br&gt;&lt;i&gt;which tools and actions it may use&lt;/i&gt;&lt;br&gt;&lt;br&gt;here: read /workspace, write /results, &lt;b&gt;no network&lt;/b&gt; (network_mode: none), no image pulls, nothing outside the container. The host never runs its code" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="230" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;5 · Error handling&lt;/b&gt;&lt;br&gt;&lt;i&gt;how it reports a failure, and when it stops&lt;/i&gt;&lt;br&gt;&lt;br&gt;here: exit code &lt;b&gt;0&lt;/b&gt; clean · &lt;b&gt;1&lt;/b&gt; findings · &lt;b&gt;anything else&lt;/b&gt; failed; a missing file is failed too · a 15-minute timeout · summary.json written on every path" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="35" y="355" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;6 · Acceptance criteria&lt;/b&gt;&lt;br&gt;&lt;i&gt;how we know the task was done&lt;/i&gt;&lt;br&gt;&lt;br&gt;here: the report file exists and the exit code is 0 or 1 → status &lt;b&gt;ok&lt;/b&gt; or &lt;b&gt;findings&lt;/b&gt;; three such statuses → a job &lt;b&gt;verdict&lt;/b&gt; (clean · findings · failed)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="355" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="same" value="&lt;b&gt;The contract is what stays stable.&lt;/b&gt; The three scanners fill it today; in Part 5 an AI reviewer gets the same inputs and owes the same kind of file. The host only reads the files." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#879196;fontColor=#232F3E;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="35" y="480" width="770" height="55" as="geometry"/></mxCell>
<mxCell id="ex" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="65" width="380" height="540" as="geometry"/></mxCell>
<mxCell id="ext" value="&lt;b&gt;A DevOps example&lt;/b&gt;: three agents, one contract between them" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="855" y="69" width="350" height="26" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;Planner agent&lt;/b&gt;&lt;br&gt;writes the work plan: tasks, permissions, success conditions&lt;br&gt;&lt;i&gt;contract: a JSON schema&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="105" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Executor agent&lt;/b&gt;&lt;br&gt;runs the plan and returns a structured result" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="215" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;Reviewer agent&lt;/b&gt;&lt;br&gt;checks the result against the acceptance criteria" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="315" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="js" value="the contract says the executor must return:&lt;br&gt;&lt;pre style=&quot;font-size:12px;margin:4px 0 0 0&quot;&gt;{&lt;br&gt;  &quot;status&quot;: &quot;success&quot;,&lt;br&gt;  &quot;tests_passed&quot;: 12,&lt;br&gt;  &quot;tests_failed&quot;: 0,&lt;br&gt;  &quot;artifacts&quot;: [&quot;report.json&quot;]&lt;br&gt;}&lt;/pre&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#879196;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="410" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="a1" value="the plan" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#147EBA;strokeWidth=2;fontColor=#147EBA;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" value="the result" style="html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontColor=#248814;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="" style="html=1;fontSize=12;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="js"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
