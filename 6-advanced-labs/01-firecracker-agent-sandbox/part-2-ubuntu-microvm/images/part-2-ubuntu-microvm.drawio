<mxCell id="l1t" value="&lt;b&gt;L1 · EC2 instance fc-agents-host&lt;/b&gt;: m7i-flex.large · Ubuntu 24.04 · nested virtualization · 30 GiB gp3 · security group: SSH from My IP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="205" y="64" width="980" height="28" as="geometry"/></mxCell>
<mxCell id="fc" value="&lt;b&gt;~/fc&lt;/b&gt;&lt;br&gt;firecracker v1.17.0&lt;br&gt;vmlinux-6.18.54 + .config&lt;br&gt;ubuntu-24.04-minimal-…-root.tar.xz (110 MB)&lt;br&gt;&lt;b&gt;ubuntu.ext4&lt;/b&gt; (4 GiB, sparse) ← the archive, via chroot&lt;br&gt;vm.json · console.log" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#879196;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="105" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;Terminal 1&lt;/b&gt;: ./firecracker --config-file vm.json&lt;br&gt;&lt;i&gt;the serial console: kernel, systemd, login:&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="330" width="330" height="60" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;Terminal 2&lt;/b&gt;: ssh root@172.16.0.2&lt;br&gt;&lt;i&gt;tests, Docker install, reboot&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="405" width="330" height="60" as="geometry"/></mxCell>
<mxCell id="tap" value="&lt;b&gt;tap0&lt;/b&gt; 172.16.0.1/30 · &lt;b&gt;NAT layer 1&lt;/b&gt;&lt;br&gt;ip_forward=1 · MASQUERADE out of the host interface&lt;br&gt;FORWARD tap0 ↔ out · DROP 169.254.169.254 (no instance metadata)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="485" width="330" height="80" as="geometry"/></mxCell>
<mxCell id="base" value="&lt;b&gt;ubuntu-docker-base.ext4&lt;/b&gt; · the base image&lt;br&gt;cp --sparse=always after the shutdown (1.5 GB used)&lt;br&gt;&lt;i&gt;every job in Part 3 starts from a copy of it&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="240" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="kvm" value="&lt;b&gt;KVM&lt;/b&gt; in the host kernel · &lt;b&gt;/dev/kvm&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="600" width="970" height="45" as="geometry"/></mxCell>
<mxCell id="fcp" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="105" width="600" height="465" as="geometry"/></mxCell>
<mxCell id="fcpt" value="&lt;b&gt;Firecracker process&lt;/b&gt;, configured from &lt;b&gt;vm.json&lt;/b&gt;: kernel · root drive · 2 vCPU · 2048 MiB · tap0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="595" y="108" width="570" height="26" as="geometry"/></mxCell>
<mxCell id="l2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="560" height="415" as="geometry"/></mxCell>
<mxCell id="l2t" value="&lt;b&gt;L2 · microVM&lt;/b&gt;: 2 vCPUs · 2 GiB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="615" y="143" width="400" height="26" as="geometry"/></mxCell>
<mxCell id="gk" value="&lt;b&gt;Guest kernel 6.18.54&lt;/b&gt; (Firecracker CI) · boot args: console=ttyS0 reboot=k panic=1 root=/dev/vda rw&lt;br&gt;namespaces · cgroup v2 · overlayfs · veth · bridge · netfilter and NAT: what Docker needs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="175" width="520" height="60" as="geometry"/></mxCell>
<mxCell id="ub" value="&lt;b&gt;Ubuntu 24.04 minimal&lt;/b&gt; on /dev/vda (ubuntu.ext4) · &lt;b&gt;systemd&lt;/b&gt; is PID 1&lt;br&gt;cloud-init off · serial-getty@ttyS0 · systemd-networkd: eth0 172.16.0.2/30, gateway 172.16.0.1 · DNS 1.1.1.1 · sshd, root with your key" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="245" width="520" height="70" as="geometry"/></mxCell>
<mxCell id="dk" value="&lt;b&gt;Docker Engine&lt;/b&gt; + Compose plugin · overlayfs · cgroup v2&lt;br&gt;&lt;b&gt;NAT layer 2&lt;/b&gt;: docker0 bridge, Docker's own iptables rules" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="325" width="520" height="60" as="geometry"/></mxCell>
<mxCell id="ct" value="&lt;b&gt;container&lt;/b&gt; alpine: writes a file to the volume &lt;b&gt;jobdata&lt;/b&gt;; a second one reads it;&lt;br&gt;a third one runs wget https://api.github.com/zen" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#ED7100;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="395" width="480" height="60" as="geometry"/></mxCell>
<mxCell id="chk" value="&lt;b&gt;The checks&lt;/b&gt; (check.sh runs the same ones): Ubuntu 24.04 inside · DNS and HTTPS from the guest · Docker active · a container runs · DNS and HTTPS from a container · no instance metadata" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontColor=#232F3E;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="520" height="70" as="geometry"/></mxCell>
