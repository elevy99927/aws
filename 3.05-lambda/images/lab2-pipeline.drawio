"1" as="geometry"/></mxCell><mxCell id="e4" value="print(&amp;quot;scanning ...&amp;quot;)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="fn" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rbp" value="&lt;b&gt;Resource-based policy&lt;/b&gt; (on the function)&lt;br&gt;a statement lets &lt;b&gt;s3.amazonaws.com&lt;/b&gt; invoke it,&lt;br&gt;only from the upload bucket. &lt;i&gt;Who may call?&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#ED7100;align=left;spacingLeft=12;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="380" height="70" as="geometry"/></mxCell><mxCell id="role" value="&lt;b&gt;Execution role: lab-scanner-role&lt;/b&gt; (assumed by the function)&lt;br&gt;• AWSLambdaBasicExecutionRole: write logs&lt;br&gt;• inline &lt;i&gt;lab-scanner-s3&lt;/i&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;s3:GetObject on upload/*&lt;br&gt;&amp;nbsp;&amp;nbsp;s3:PutObject on clean/*&lt;br&gt;&lt;i&gt;What may the code do?&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE8EA;strokeColor=#DD344C;align=left;spacingLeft=12;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="440" width="360" height="130" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="role" target="fn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="warn" value="⚠ &lt;b&gt;Never write to the bucket that triggers the function.&lt;/b&gt;&lt;br&gt;Each copy would be a new upload, which triggers the function again:&lt;br&gt;an infinite loop. Two buckets keep the pipeline safe." style="fillColor=#FFFFFF;strokeColor=#DD3522;verticalAlign=middle;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;dashed=1;align=left;spacingLeft=12;fontSize=12;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="520" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>