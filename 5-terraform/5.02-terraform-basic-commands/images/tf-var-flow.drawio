<mxfile host="app.diagrams.net"><diagram id="d" name="Page-1"><mxGraphModel dx="720" dy="520" grid="1" gridSize="10" page="1" pageWidth="720" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="shell" value='&lt;b&gt;Shell&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Courier New,monospace;"&gt;export &lt;font color="#AAB7B8"&gt;TF_VAR_&lt;/font&gt;&lt;b&gt;&lt;font color="#FF9900"&gt;AWS_ACCESS_KEY&lt;/font&gt;&lt;/b&gt;=Aa123456&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=15;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="640" height="74" as="geometry"/></mxCell><mxCell id="vars" value='&lt;b&gt;vars.tf&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Courier New,monospace;"&gt;variable "&lt;b&gt;&lt;font color="#FF9900"&gt;AWS_ACCESS_KEY&lt;/font&gt;&lt;/b&gt;" {}&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=15;fillColor=#FFF8E6;strokeColor=#FF9900;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="640" height="74" as="geometry"/></mxCell><mxCell id="main" value='&lt;b&gt;main.tf&lt;/b&gt; (the provider block)&lt;br&gt;&lt;span style="font-family:Courier New,monospace;"&gt;access_key = var.&lt;b&gt;&lt;font color="#FF9900"&gt;AWS_ACCESS_KEY&lt;/font&gt;&lt;/b&gt;   &lt;font color="#1D8102"&gt;# = "Aa123456"&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=15;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="640" height="74" as="geometry"/></mxCell><mxCell id="t1" value="Terraform removes the &lt;b&gt;TF_VAR_&lt;/b&gt; prefix, and looks for a variable with that name" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="220" y="104" width="460" height="70" as="geometry"/></mxCell><mxCell id="t2" value="The code reads it as &lt;b&gt;var.AWS_ACCESS_KEY&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="220" y="268" width="460" height="70" as="geometry"/></mxCell><mxCell id="note" value="Without the &lt;b&gt;variable&lt;/b&gt; block, Terraform ignores &lt;b&gt;TF_VAR_AWS_ACCESS_KEY&lt;/b&gt;.&lt;br&gt;Without a value (and no default), &lt;b&gt;terraform plan&lt;/b&gt; asks: &lt;i&gt;Enter a value&lt;/i&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=12;dashed=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="640" height="56" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="shell" target="vars"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="vars" target="main"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>